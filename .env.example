# RetailIQ Environment Configuration

# Backend API Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production

# Database (Default: local SQLite database in app/db/retailiq.db)
# Optional: PostgreSQL Connection String for shared production deployments
# DATABASE_URL=postgresql://user:password@localhost:5432/retailiq

# Optional: LLM Provider for dynamic consultant responses (leave empty for deterministic engine)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
